{
  "name": "threejs-video-studio",
  "version": "0.1.0",
  "description": "Deterministic Three.js films with a self-contained production standard.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/studio.mjs preview",
    "check": "node scripts/studio.mjs check",
    "render": "node scripts/studio.mjs render",
    "package": "node scripts/studio.mjs package",
    "qa": "node scripts/browser-qa.mjs",
    "verify:video": "python3 scripts/verify_video.py"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "hyperframes": "0.8.181",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.183.1",
    "esbuild": "0.25.12",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "typescript": "5.9.3"
  }
}
