[
  {
    "id": "S01-1",
    "shot": "S01",
    "text": "Your website's code hasn't even started.",
    "gapBefore": 0.25,
    "startSample": 14400,
    "endSample": 132580,
    "start": 0.3,
    "end": 2.7620833333333334,
    "sha256": "e8e36f361a2fefc28da9c9a1aceb70db03a3e336d16fc9b75bcbd23f3c51c575",
    "baselineSha256": "f7442e86cca7a31e1428f144bf20a36d6fe2936a3bff0787fcbeb5ed6baaa251",
    "trimStartSample48k": 1736,
    "trimEndSample48k": 119916
  },
  {
    "id": "S01-2",
    "shot": "S01",
    "text": "But PHP is already parsing an incoming request.",
    "gapBefore": 0.25,
    "startSample": 144580,
    "endSample": 308777,
    "start": 3.0120833333333334,
    "end": 6.432854166666667,
    "sha256": "f15dae9afcf3e9da4e104373ead9ccc2da3a8d71a0a257f387d5d726f746cf72",
    "baselineSha256": "10afbefaaf36b19a80a6b386a92a1fc7cdf48053f1a45b834f8bc0d9c8807896",
    "trimStartSample48k": 1686,
    "trimEndSample48k": 165883
  },
  {
    "id": "S02-1",
    "shot": "S02",
    "text": "While internal data is still being initialized, a memory allocation fails.",
    "gapBefore": 0.25,
    "startSample": 320777,
    "endSample": 561906,
    "start": 6.682854166666667,
    "end": 11.706375,
    "sha256": "e5524e7306528964ca45b8ca2b2b592a3253c477b5abef0b976974e3e0a3394f",
    "baselineSha256": "2ee207e50502890ade5831e8502974e25f3bde8eb67dd18502042a364991e774",
    "trimStartSample48k": 2385,
    "trimEndSample48k": 243514
  },
  {
    "id": "S03-1",
    "shot": "S03",
    "text": "PHP's old out-of-memory handling jumps out of that work.",
    "gapBefore": 0.25,
    "startSample": 573906,
    "endSample": 768248,
    "start": 11.956375,
    "end": 16.005166666666668,
    "sha256": "ba387e037b51b4c734c3c2e216f5c28244498a59f020b98919996df0db99ff1e",
    "baselineSha256": "75344bab5313adab048329f9afe0dcc606c6e1200d5db87787e16ee0e5282c7f",
    "trimStartSample48k": 1419,
    "trimEndSample48k": 195761
  },
  {
    "id": "S04-1",
    "shot": "S04",
    "text": "The trouble comes next: cleanup can treat the unfinished data as valid.",
    "gapBefore": 0.55,
    "startSample": 794648,
    "endSample": 1010080,
    "start": 16.55516666666667,
    "end": 21.043333333333333,
    "sha256": "d2367692571e595850b15ad9953e2dcafb4ca36eeba5517bc32358dbc7cad03d",
    "baselineSha256": "47657f8343e9ca7aec928646097d67cc81e34e1d014b9fb8e41218a0054d6585",
    "trimStartSample48k": 677,
    "trimEndSample48k": 216109
  },
  {
    "id": "S04-2",
    "shot": "S04",
    "text": "With a carefully crafted request, that memory error can become remote code execution, without a login.",
    "gapBefore": 0.25,
    "startSample": 1022080,
    "endSample": 1343968,
    "start": 21.293333333333333,
    "end": 27.999333333333333,
    "sha256": "cf7936e496be1bd7f258518c8a11344d026cd888758e9fa47ccac93af5d96d5a",
    "baselineSha256": "429fc4f961955de1584367df8b1901964d3bc280f721aeec649c7edcc78726e5",
    "trimStartSample48k": 5456,
    "trimEndSample48k": 327344
  },
  {
    "id": "S05-1",
    "shot": "S05",
    "text": "The code runs with the web worker's permissions, so root access isn't automatic.",
    "gapBefore": 0.25,
    "startSample": 1355968,
    "endSample": 1603180,
    "start": 28.249333333333333,
    "end": 33.39958333333333,
    "sha256": "037b9f97bb7693ce8cabf827927bc3b8432410002e17bfaac541166eb56627ff",
    "baselineSha256": "b37d5d7b5faf14721e5143deb9eb30ef3c727bd21bdde66c0c8f90fd607df482",
    "trimStartSample48k": 1165,
    "trimEndSample48k": 248377
  },
  {
    "id": "S05-2",
    "shot": "S05",
    "text": "This was demonstrated with Apache's mod_php; other deployments have different conditions.",
    "gapBefore": 0.25,
    "startSample": 1615180,
    "endSample": 1903885,
    "start": 33.64958333333333,
    "end": 39.66427083333333,
    "sha256": "0090d73d1b0e2b22099f625fa72a3491d5229abc59e5e800458b7c078e86f663",
    "baselineSha256": "17983b999e64653cf4019da9bbae8d6410da85113ca62f4db56609022924f59b",
    "trimStartSample48k": 1453,
    "trimEndSample48k": 290158
  },
  {
    "id": "S06-1",
    "shot": "S06",
    "text": "PHP patched the flaw on October twenty-first.",
    "gapBefore": 0.25,
    "startSample": 1915885,
    "endSample": 2058608,
    "start": 39.91427083333333,
    "end": 42.88766666666667,
    "sha256": "f0b073e455faf5ba2ed8ee28cff94d0a3307a513bda37afcaaee2a22482fdd29",
    "baselineSha256": "706817f311cf6937bddfce7bb695fb6dfb62ae0137bc5cf7c50141679ff078f5",
    "trimStartSample48k": 2529,
    "trimEndSample48k": 145252
  },
  {
    "id": "S06-2",
    "shot": "S06",
    "text": "Update the PHP runtime, then verify the running service has loaded the fix.",
    "gapBefore": 0.25,
    "startSample": 2070608,
    "endSample": 2326552,
    "start": 43.13766666666667,
    "end": 48.469833333333334,
    "sha256": "833f980853d7cecbc3ceeac970a680f4915a4a9a95ad0756a95bffc32c630e1e",
    "baselineSha256": "4c40140d95dda02e517b61cb7ee3f9dd1ef63bad3a4ecbfc1b7a7cbbc597aac9",
    "trimStartSample48k": 6045,
    "trimEndSample48k": 261989
  },
  {
    "id": "S06-3",
    "shot": "S06",
    "text": "A firewall can't repair the runtime underneath your site.",
    "gapBefore": 0.25,
    "startSample": 2338552,
    "endSample": 2493302,
    "start": 48.719833333333334,
    "end": 51.94379166666667,
