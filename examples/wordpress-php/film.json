  "narration": [
    {
      "id": "S01-1",
      "shot": "S01",
      "text": "You updated WordPress.",
      "gapBefore": 0.25
    },
    {
      "id": "S01-2",
      "shot": "S01",
      "text": "But what about the PHP running it?",
      "gapBefore": 0.25
    },
    {
      "id": "S02-1",
      "shot": "S02",
      "text": "WordPress, themes, and plugins contain code.",
      "gapBefore": 0.25
    },
    {
      "id": "S02-2",
      "shot": "S02",
      "text": "PHP runs their server-side code.",
      "gapBefore": 0.25
    },
    {
      "id": "S03-1",
      "shot": "S03",
      "text": "A green WordPress update badge does not confirm that PHP's security fixes are installed.",
      "gapBefore": 0.55
    },
    {
      "id": "S03-2",
      "shot": "S03",
      "text": "The runtime can have a vulnerability even when WordPress itself is current.",
      "gapBefore": 0.25
    },
    {
      "id": "S04-1",
      "shot": "S04",
      "text": "Start with Tools, Site Health, Info, then Server.",
      "gapBefore": 0.25
    },
    {
      "id": "S04-2",
      "shot": "S04",
      "text": "Note the PHP version.",
      "gapBefore": 0.25
    },
    {
      "id": "S05-1",
      "shot": "S05",
      "text": "Then ask your host or server administrator to confirm the installed security fixes.",
      "gapBefore": 0.25
    },
    {
      "id": "S06-1",
      "shot": "S06",
      "text": "Vendors may patch an older package without adopting the newest PHP version.",
      "gapBefore": 0.25
    },
    {
      "id": "S06-2",
      "shot": "S06",
      "text": "Managed hosting may handle updates for you.",
      "gapBefore": 0.25
    },
    {
      "id": "S07-1",
      "shot": "S07",
      "text": "Before an upgrade, back up and test compatibility.",
      "gapBefore": 0.25
    },
    {
      "id": "S07-2",
      "shot": "S07",
      "text": "Afterward, verify the PHP actually serving your site.",
      "gapBefore": 0.25
    }
  ],
