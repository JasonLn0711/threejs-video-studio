    "trimStartSample48k": 2343,
    "trimEndSample48k": 239357
  },
  {
    "id": "S04-1",
    "shot": "S04",
    "text": "Now the same worker handles another request.",
    "gapBefore": 0.25,
    "startSample": 766873,
    "endSample": 895504,
    "start": 15.976520833333334,
    "end": 18.656333333333333,
    "sha256": "6f2d336ab820cb601a18f9dce5c53d945ab9a742cf80234c2bcf7020d65a5c4d",
    "baselineSha256": "e3607d78eca17de0c47760aff62f643d2b04b191a4fadae2d80db5676bad089f",
    "trimStartSample48k": 1913,
    "trimEndSample48k": 130544
  },
  {
    "id": "S04-2",
    "shot": "S04",
    "text": "Before normal initialization resets that state, an early operation can use the stale reference.",
    "gapBefore": 0.25,
    "startSample": 907504,
    "endSample": 1208329,
    "start": 18.906333333333333,
    "end": 25.173520833333335,
    "sha256": "6d21b3cea546d0c619a514622c1cac415aa74361894e26de1f7c76486e082dac",
    "baselineSha256": "a63fc286e83963640d7a7537cb4beb12b66008317165d250d5ba1fe0d19b2ca2",
    "trimStartSample48k": 1895,
    "trimEndSample48k": 302720
  },
  {
    "id": "S05-1",
    "shot": "S05",
    "text": "That's use-after-free: accessing memory after its lifetime has ended.",
    "gapBefore": 0.55,
    "startSample": 1234729,
    "endSample": 1452635,
    "start": 25.723520833333332,
    "end": 30.263229166666665,
    "sha256": "473d997f3e23c68e955fd7e730873bde0ea6484e077b3a7e3f07b59faa62e5e5",
