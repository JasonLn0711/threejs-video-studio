    "trimStartSample48k": 1392,
    "trimEndSample48k": 211021
  },
  {
    "id": "S02-2",
    "shot": "S02",
    "text": "Worker-wide state keeps a reference to that data.",
    "gapBefore": 0.25,
    "startSample": 372400,
    "endSample": 505859,
    "start": 7.758333333333334,
    "end": 10.538729166666666,
