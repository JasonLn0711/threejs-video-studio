    "trimStartSample48k": 2712,
    "trimEndSample48k": 136171
  },
  {
    "id": "S03-1",
    "shot": "S03",
    "text": "When the request ends, its memory is released, but some state can still point there.",
    "gapBefore": 0.25,
    "startSample": 517859,
    "endSample": 754873,
    "start": 10.788729166666666,
    "end": 15.726520833333334,
    "sha256": "876ab3e6ff482522f80aa9094e30caaa353d4f67996700745d4a16e392b6fc92",
