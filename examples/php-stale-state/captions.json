    "trimStartSample48k": 1194,
    "trimEndSample48k": 61760
  },
  {
    "id": "S01-2",
    "shot": "S01",
    "text": "Its pointer isn't.",
    "gapBefore": 0.25,
    "startSample": 86966,
    "endSample": 138771,
