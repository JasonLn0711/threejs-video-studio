    "trimStartSample48k": 1893,
    "trimEndSample48k": 219799
  },
  {
    "id": "S05-2",
    "shot": "S05",
    "text": "Under exploitable conditions, an attacker can turn that memory error into remote code execution.",
    "gapBefore": 0.25,
    "startSample": 1464635,
    "endSample": 1763737,
    "start": 30.513229166666665,
    "end": 36.74452083333333,
