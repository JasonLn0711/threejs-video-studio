    "trimStartSample48k": 3868,
    "trimEndSample48k": 55673
  },
  {
    "id": "S02-1",
    "shot": "S02",
    "text": "Inside a PHP worker, one request creates data in memory.",
    "gapBefore": 0.25,
    "startSample": 150771,
    "endSample": 360400,
    "start": 3.1410625,
    "end": 7.508333333333334,
    "sha256": "b918eb19e66a4dd231cacbc579cc94bf907d8044ce64522991f71a7914cc5343",
