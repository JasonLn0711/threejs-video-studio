  "narration": [
    {
      "id": "S01-1",
      "shot": "S01",
      "text": "The request is gone.",
      "gapBefore": 0.25
    },
    {
      "id": "S01-2",
      "shot": "S01",
      "text": "Its pointer isn't.",
      "gapBefore": 0.25
    },
    {
      "id": "S02-1",
      "shot": "S02",
      "text": "Inside a PHP worker, one request creates data in memory.",
      "gapBefore": 0.25
    },
    {
      "id": "S02-2",
      "shot": "S02",
      "text": "Worker-wide state keeps a reference to that data.",
      "gapBefore": 0.25
    },
    {
      "id": "S03-1",
      "shot": "S03",
      "text": "When the request ends, its memory is released, but some state can still point there.",
      "gapBefore": 0.25
    },
    {
      "id": "S04-1",
      "shot": "S04",
      "text": "Now the same worker handles another request.",
      "gapBefore": 0.25
    },
    {
      "id": "S04-2",
      "shot": "S04",
      "text": "Before normal initialization resets that state, an early operation can use the stale reference.",
      "gapBefore": 0.25
    },
    {
      "id": "S05-1",
      "shot": "S05",
      "text": "That's use-after-free: accessing memory after its lifetime has ended.",
      "gapBefore": 0.55
    },
    {
      "id": "S05-2",
      "shot": "S05",
      "text": "Under exploitable conditions, an attacker can turn that memory error into remote code execution.",
      "gapBefore": 0.25
    },
    {
      "id": "S05-3",
      "shot": "S05",
      "text": "That means the worker's permissions, not automatic root access.",
      "gapBefore": 0.25
    },
    {
      "id": "S06-1",
      "shot": "S06",
      "text": "The exact trigger depends on the deployment and internal state involved.",
      "gapBefore": 0.25
    },
    {
      "id": "S06-2",
      "shot": "S06",
      "text": "PHP's fix addresses this lifecycle bug.",
      "gapBefore": 0.25
    },
    {
      "id": "S06-3",
      "shot": "S06",
      "text": "Patch the runtime, restart affected workers, and verify the version actually serving requests.",
      "gapBefore": 0.25
    }
  ],
