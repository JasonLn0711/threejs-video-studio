      "trimStartSample48k": 2825,
      "trimEndSample48k": 62026
    },
    {
      "id": 1,
      "text": "Why won't the page load?",
      "start": 1.9333541666666667,
      "end": 3.2134583333333335,
      "startSample": 92801,
      "endSample": 154246,
      "sha256": "4bd3c6e1943affded8b8b5b8eee42abcae32a5e1db0f36823f61202b34837a2d",
      "baselineSha256": "ae054b7ec1686f45721a0b18ff0d583c8507128623b6625d235e305b6698d286",
      "trimStartSample48k": 1437,
      "trimEndSample48k": 62882
    },
    {
      "id": 2,
      "text": "Follow the traffic.",
      "start": 3.563458333333333,
      "end": 4.614270833333333,
      "startSample": 171046,
      "endSample": 221485,
      "sha256": "ee73a6dacdf4fee698d44ae5f3dc1f7e71d2682bd13ddf631aaee9032fb7d6ad",
      "baselineSha256": "629feea3b6d0133e73c2ee3168626e6f39d418a81f3dc44e6cd41060793c0926",
      "trimStartSample48k": 1315,
      "trimEndSample48k": 51754
    },
    {
      "id": 3,
      "text": "This network link has limited capacity.",
      "start": 4.964270833333333,
      "end": 7.300625,
      "startSample": 238285,
      "endSample": 350430,
      "sha256": "b43a8af885fdf67d7db5757352dbdb33f4dde87180f2c006dca797f69c4fa47f",
      "baselineSha256": "2f1f0ce5a00f3b08e63a5a34c75b3312c25b1a057727c3598cca7ea636f99d10",
      "trimStartSample48k": 2009,
      "trimEndSample48k": 114154
    },
    {
      "id": 4,
      "text": "Normally, packets pass through and the service stays reachable.",
      "start": 7.650625,
      "end": 10.944895833333334,
      "startSample": 367230,
      "endSample": 525355,
      "sha256": "baf50580d5f686dc11106a8983b3caec7e1b69f3bfb30d28d27c114721e97ba7",
      "baselineSha256": "8eecbe34c4689eab3265ad6a4107a9c0c99ac8b7a123c722df1538bc20737007",
      "trimStartSample48k": 1463,
      "trimEndSample48k": 159588
    },
    {
      "id": 5,
      "text": "Now, many devices send attack traffic toward the same destination.",
      "start": 11.294895833333333,
      "end": 15.345770833333333,
      "startSample": 542155,
      "endSample": 736597,
      "sha256": "5448ab8913393dbe5ddc9a8ca2b749c3ff7f85cb51612d5c561f3a561e0fb55d",
      "baselineSha256": "75d6464b66d85cf4fbc15bf423ad853c02c2a6301f1d9e83fb4f2415d2f70a23",
      "trimStartSample48k": 1848,
      "trimEndSample48k": 196290
    },
    {
      "id": 6,
      "text": "Their separate paths converge on one shared link.",
      "start": 15.695770833333333,
      "end": 18.1520625,
      "startSample": 753397,
      "endSample": 871299,
      "sha256": "c42ea227fc5cff8abc5c2cfbc2c70b706ae74f40d869cbafef011ab2a692b7fa",
      "baselineSha256": "ccc8dca8b290e51dbe019a02f5a1b56bf9cfd80dbb1453d70a0f2b55fedc1132",
      "trimStartSample48k": 1585,
      "trimEndSample48k": 119487
    },
    {
      "id": 7,
      "text": "Its capacity hasn't changed.",
      "start": 18.5020625,
      "end": 20.137583333333332,
      "startSample": 888099,
      "endSample": 966604,
      "sha256": "dcf3e47a9fa870039d7c81704c039931e06fb0e16fc8bd96274656de1477ba3e",
      "baselineSha256": "382ae714ffdb93496f68b79ebcd78a6e481bb6ee69daa0d998924a178e28df0d",
      "trimStartSample48k": 1089,
      "trimEndSample48k": 79594
    },
    {
      "id": 8,
      "text": "More traffic arrives than the link can carry.",
      "start": 20.487583333333333,
      "end": 22.809770833333335,
      "startSample": 983404,
      "endSample": 1094869,
      "sha256": "a049788d417bf7d1a129d6253faa7c410aa7658fbcc53b9d1617bedeafea786e",
      "baselineSha256": "f9417108b0bb425fde830ebaeffb47ae82b448aba133c77780c36f2b4401d499",
      "trimStartSample48k": 1773,
      "trimEndSample48k": 113238
    },
    {
      "id": 9,
      "text": "Packets wait in a queue.",
      "start": 23.159770833333333,
      "end": 24.364958333333334,
      "startSample": 1111669,
      "endSample": 1169518,
      "sha256": "8c4f726f5d98a60cf9c1c2d5dbce70f6f1b33b8daa405153be9b2fc6b6f47ee3",
      "baselineSha256": "105f9a4267a5bac9db818a6c66a408f99c90383106d253e572c2c69d2df00778",
      "trimStartSample48k": 1433,
      "trimEndSample48k": 59282
    },
    {
      "id": 10,
      "text": "When that queue fills, additional packets are dropped.",
      "start": 24.714958333333332,
      "end": 27.424270833333335,
      "startSample": 1186318,
      "endSample": 1316365,
      "sha256": "0a5349725ae16a667d13971e6fdbfc25fe8fc5977a4f43026efeb4d006efc4b5",
      "baselineSha256": "763a2b7b7c96a290a19276972bf8c6febac01dae08c785e98a818e53ddc6a26e",
      "trimStartSample48k": 2207,
      "trimEndSample48k": 132254
    },
    {
      "id": 11,
      "text": "Legitimate traffic shares this bottleneck too.",
      "start": 27.774270833333333,
      "end": 30.253020833333334,
      "startSample": 1333165,
      "endSample": 1452145,
      "sha256": "408c8cfe5a8608d3702e51bdffb3953dd2f155938aabfd96c7cdc27115bde42c",
      "baselineSha256": "2128a966a8f57c233dab306e3c33b5be599882afcfb7597b60cbbe8ffe77db16",
      "trimStartSample48k": 2476,
      "trimEndSample48k": 121456
    },
    {
      "id": 12,
      "text": "A normal request may be delayed or lost before it reaches the server.",
      "start": 30.603020833333332,
      "end": 34.613770833333334,
      "startSample": 1468945,
      "endSample": 1661461,
      "sha256": "1e8a770a03302bc5f67cfa64bf662652d57b95b3e4542c516d95793b665d4a6f",
      "baselineSha256": "0406296a532b1c31141179f48880c67939792beb033d158ab645e7e018907136",
      "trimStartSample48k": 1259,
      "trimEndSample48k": 193775
    },
    {
      "id": 13,
      "text": "The machine can still be running while users cannot reach it.",
      "start": 34.963770833333335,
      "end": 37.947541666666666,
      "startSample": 1678261,
      "endSample": 1821482,
      "sha256": "27b401a529f00de0fcd6b50347ac7902e4cc198246a96943c370c07009c176af",
